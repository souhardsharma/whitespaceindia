{
  "name": "whitespace-india",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "predev": "node scripts/instruments/runtime_index.mjs && node scripts/instruments/proposal_pages.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/instruments/runtime_index.mjs && node scripts/instruments/proposal_pages.mjs",
    "build": "next build",
    "build:cloudflare": "npm run build && node scripts/cloudflare/assemble.mjs . dist",
    "start": "next start",
    "lint": "next lint",
    "lint:instruments": "next lint --dir app/instruments --dir components/instruments --dir lib/instruments --dir app/api/instruments",
    "test": "node --test \"lib/**/__tests__/*.test.ts\" \"components/**/__tests__/*.test.ts\" \"app/**/__tests__/*.test.ts\"",
    "pretest": "node scripts/assert-tests-discovered.mjs && node scripts/instruments/proposal_pages.mjs"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.4.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "botid": "^1.5.11",
    "d3-geo": "^3.1.1",
    "d3-scale": "^4.0.2",
    "framer-motion": "^12.38.0",
    "next": "^15.5.28",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "react-simple-maps": "^3.0.0",
    "recharts": "^3.8.1",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^20",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "autoprefixer": "^10.0.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.31",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "react-simple-maps": {
      "react": "$react",
      "react-dom": "$react-dom"
    },
    "d3-color": "^3.1.0",
    "postcss": "$postcss",
    "sharp": "$sharp"
  }
}
