# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
# the server's index into public/data, rebuilt by every build and dev start
/.runtime/
# the static files proposal pages are assembled from, rebuilt the same way
/public/view/
/out/
# the Cloudflare Pages copy of a build (scripts/cloudflare/assemble.mjs)
/dist/
/.wrangler/
build/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files: every variant (.env.production, .env.preview, ...), so a new
# name cannot slip a secret into this public repository. Only the example
# file, which holds no values, may be committed.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Python
__pycache__/
*.py[cod]
*$py.class

# Local pipeline artifacts
scripts/**/verification_report.json
scripts/**/_baseline/
scripts/**/__pycache__/

# Local-only landing image source backups (input for scripts/optimize_landing.py)
public/landing/_orig_backup/

# Local design exploration scratch
.design-options/

# Browser-automation scratch. Page dumps and console logs from driving the
# preview server; useful while debugging, never part of the project.
.playwright-mcp/

# The instruments fetch cache. Roughly 250 MB of PARIVESH register, SHRUG
# tables and boundary files. It belongs OUTSIDE the repository - see
# INSTRUMENTS_CACHE_DIR in scripts/instruments/build_data.py - but a run
# pointed at the default location here would otherwise stage all of it.
.instruments-cache/
