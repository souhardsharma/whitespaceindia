{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Amazonbot|SemrushBot|AhrefsBot|MJ12bot|DotBot|PetalBot|Bytespider|DataForSeoBot|BLEXBot|GoogleOther).*"
        }
      ],
      "mitigate": {
        "action": "deny"
      }
    },
    {
      "src": "^/instruments/consent/(?!(?:appraisal|data|district|feed|latest|methodology|register|sitemap)(?:[/.]|$))[^/0-9][^/]*/?$",
      "mitigate": {
        "action": "deny"
      }
    }
  ]
}
