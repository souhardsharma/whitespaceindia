{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "mkdir -p vercel-redirect-only && echo 'Moved to https://whitespaceindia.pages.dev' > vercel-redirect-only/index.html && cp public/googlec2c59ca60c194f86.html vercel-redirect-only/",
  "outputDirectory": "vercel-redirect-only",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "whitespaceindia-csr\\.vercel\\.app|csr\\.whitespaceindia\\.com" }],
      "destination": "https://whitespaceindia.pages.dev/csr",
      "permanent": true
    },
    {
      "source": "/(.+)/",
      "destination": "https://whitespaceindia.pages.dev/$1",
      "permanent": true
    },
    {
      "source": "/((?!googlec2c59ca60c194f86\\.html$).*)",
      "destination": "https://whitespaceindia.pages.dev/$1",
      "permanent": true
    }
  ]
}
